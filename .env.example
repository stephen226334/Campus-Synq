# CampusSynq Root Environment Template
# Copy this file to backend/.env and frontend/.env respectively

# --- Backend Configuration ---
PORT=5000
# Database: Local MongoDB (Default) or MongoDB Atlas (Cloud Cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/campus_synq
# Atlas: MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/campus_synq?retryWrites=true&w=majority
DB_NAME=campus_synq
JWT_SECRET=replace_with_strong_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Mail Service (Optional)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=smtp_username
MAIL_PASSWORD=smtp_password
MAIL_FROM="Campus Synq Administration <admin@campussynq.edu>"

# --- Frontend Configuration ---
VITE_API_URL=
